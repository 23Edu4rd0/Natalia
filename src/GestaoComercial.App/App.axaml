<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GestaoComercial.App.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#4F46E5" RegionColor="#F5F6FA" ErrorText="#DC2626" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- ===== Botões ===== -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D5DAE5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#1F2937" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F3F4F8" />
      <Setter Property="BorderBrush" Value="#C3CAD9" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E8EBF2" />
    </Style>

    <Style Selector="Button.primario">
      <Setter Property="Background" Value="#4F46E5" />
      <Setter Property="BorderBrush" Value="#4F46E5" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primario:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4338CA" />
      <Setter Property="BorderBrush" Value="#4338CA" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primario:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3730A3" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primario:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C7C9F4" />
      <Setter Property="BorderBrush" Value="#C7C9F4" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="Button.perigo">
      <Setter Property="Foreground" Value="#B91C1C" />
      <Setter Property="BorderBrush" Value="#FCA5A5" />
    </Style>
    <Style Selector="Button.perigo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FEF2F2" />
      <Setter Property="BorderBrush" Value="#F87171" />
      <Setter Property="TextElement.Foreground" Value="#991B1B" />
    </Style>

    <Style Selector="Button.verde">
      <Setter Property="Background" Value="#16A34A" />
      <Setter Property="BorderBrush" Value="#16A34A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.verde:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#15803D" />
      <Setter Property="BorderBrush" Value="#15803D" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="Button.chip">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Background" Value="#EEF2FF" />
      <Setter Property="BorderBrush" Value="#C7D2FE" />
      <Setter Property="Foreground" Value="#3730A3" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E0E7FF" />
      <Setter Property="BorderBrush" Value="#A5B4FC" />
      <Setter Property="TextElement.Foreground" Value="#312E81" />
    </Style>

    <!-- Menu lateral -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#C7D2FE" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2B2870" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="Button.nav.ativo /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4F46E5" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <!-- ===== Campos ===== -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D5DAE5" />
    </Style>
    <Style Selector="AutoCompleteBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D5DAE5" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D5DAE5" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- ===== Cartões e textos ===== -->
    <Style Selector=":is(Border).cartao">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E6E9F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #12000000" />
    </Style>
    <Style Selector="TextBlock.sub">
      <Setter Property="Foreground" Value="#6B7280" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#111827" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#111827" />
    </Style>
    <Style Selector="TextBlock.rotulo">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#6B7280" />
    </Style>
    <Style Selector="TextBlock.kpi">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#111827" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===== Tabelas ===== -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Padding" Value="12,0,0,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#6B7280" />
      <Setter Property="Background" Value="#F9FAFB" />
      <Setter Property="SeparatorBrush" Value="Transparent" />
    </Style>
    <Style Selector="DataGridColumnHeader /template/ Path#SortIcon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#E0E7FF" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#F3F4FF" />
    </Style>
  </Application.Styles>
</Application>
