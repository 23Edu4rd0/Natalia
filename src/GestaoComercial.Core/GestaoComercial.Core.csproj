<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>GestaoComercial.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.32" />
    <!-- NF-e / NFC-e: montagem, assinatura e comunicação com a SEFAZ (ZeusFiscal, LGPL-2.1) -->
    <PackageReference Include="Hercules.NET.NFe.NFCe" Version="2026.10.19.2059" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- esquemas oficiais (XSD) da NF-e 4.00, extraídos para a pasta de dados na primeira emissão -->
    <EmbeddedResource Include="Fiscal/Schemas/*.xsd" LogicalName="schemas/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
